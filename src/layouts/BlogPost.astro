---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import type { LangCode } from '../utils/i18n';
import type { PublishedPost } from '../utils/posts';

type Props = PublishedPost['data'] & {
	lang?: string;
	dir?: 'ltr' | 'rtl';
	translationHrefs?: Partial<Record<LangCode | 'de', string>>;
};

const { title, description, pubDate, updatedDate, lang = 'de', dir = 'ltr', translationHrefs } = Astro.props;
---

<html lang={lang} dir={dir}>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header translationHrefs={translationHrefs} />
		<main>
			<article>
				<h1>{title}</h1>
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated">
								(updated <FormattedDate date={updatedDate} />)
							</span>
						)
					}
				</div>
				<hr />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.date {
		color: var(--fg-muted);
		font-size: 0.9em;
	}
	.updated {
		font-style: italic;
	}
</style>
