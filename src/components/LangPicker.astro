---
import { DE, LANGUAGES, type LangCode } from '../utils/i18n';

interface Props {
	current: LangCode | 'de';
	hrefs: Partial<Record<LangCode | 'de', string>>;
}

const { current, hrefs } = Astro.props;
const all = [DE, ...LANGUAGES];
const entries = all.filter((l) => hrefs[l.code]);
const currentEntry = entries.find((l) => l.code === current) ?? DE;
---

<div class="lang-picker">
	<button
		id="lang-picker-toggle"
		type="button"
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="lang-picker-menu"
		aria-label={`Language: ${currentEntry.label}`}
	>
		<span aria-hidden="true">{currentEntry.flag}</span>
	</button>
	<div class="lang-picker-menu" id="lang-picker-menu">
		{
			entries.map((l) => (
				<a href={hrefs[l.code]} class:list={['lang-option', { active: l.code === current }]}>
					<span class="flag" aria-hidden="true">
						{l.flag}
					</span>
					<span class="label">{l.label}</span>
				</a>
			))
		}
	</div>
</div>

<script is:inline>
	(function () {
		const wrapper = document.querySelector('.lang-picker');
		const toggle = document.getElementById('lang-picker-toggle');
		const menu = document.getElementById('lang-picker-menu');

		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = menu.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(open));
		});

		document.addEventListener('click', (e) => {
			if (!wrapper.contains(e.target)) {
				menu.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	})();
</script>

<style>
	.lang-picker {
		position: relative;
	}
	#lang-picker-toggle {
		display: inline-flex;
		align-items: center;
		font-size: 1.1em;
		line-height: 1;
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.25em 0.5em;
		cursor: pointer;
	}
	.lang-picker-menu {
		display: none;
		flex-direction: column;
		position: absolute;
		top: 100%;
		inset-inline-end: 0;
		margin-top: 0.4em;
		min-width: 9em;
		max-width: calc(100vw - 2em);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.4em;
		z-index: 20;
	}
	.lang-picker-menu.open {
		display: flex;
	}
	.lang-option {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.35em 0.5em;
		border-radius: 4px;
		text-decoration: none;
		color: var(--fg-muted);
		white-space: nowrap;
	}
	.lang-option:hover {
		background: var(--code-bg);
	}
	.lang-option.active {
		color: var(--fg);
		font-weight: 600;
	}
	.lang-option .flag {
		font-size: 1.1em;
	}
</style>
