---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2em 1em;
		text-align: center;
		color: var(--fg-muted);
		font-size: 0.9em;
	}
	p {
		margin: 0;
	}
</style>
