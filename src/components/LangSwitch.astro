---
import { DE, LANGUAGES, type LangCode } from '../utils/i18n';

interface Props {
	current: LangCode | 'de';
	hrefs: Partial<Record<LangCode | 'de', string>>;
}

const { current, hrefs } = Astro.props;
const all = [DE, ...LANGUAGES];
const entries = all.filter((l) => hrefs[l.code]);
---

<div class="lang-switch">
	{
		entries.map((l) => (
			<a
				href={hrefs[l.code]}
				class:list={['flag', { inactive: l.code !== current }]}
				aria-label={l.label}
				title={l.label}
			>
				{l.flag}
			</a>
		))
	}
</div>

<style>
	.lang-switch {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em;
	}
	.flag {
		font-size: 1.1em;
		line-height: 1;
		text-decoration: none;
		filter: none;
		opacity: 1;
		transition:
			filter 0.15s,
			opacity 0.15s;
	}
	.flag.inactive {
		filter: grayscale(1);
		opacity: 0.4;
	}
	.flag.inactive:hover {
		opacity: 0.7;
	}
</style>
