---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const enPrefix = withBase('blog/en');
const isEnglish = Astro.url.pathname === enPrefix || Astro.url.pathname.startsWith(`${enPrefix}/`);
---

<header>
	<nav>
		<a class="site-title" href={withBase('')}>{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href={withBase('blog')}>Blog</HeaderLink>
			<HeaderLink href={withBase('about')}>About</HeaderLink>
			<div class="lang-theme">
				<div class="lang-switch">
					<a href={withBase('blog')} class:list={['flag', { inactive: isEnglish }]} aria-label="Deutsch" title="Deutsch">
						🇩🇪
					</a>
					<a href={withBase('blog/en')} class:list={['flag', { inactive: !isEnglish }]} aria-label="English" title="English">
						🇬🇧
					</a>
				</div>
				<ThemeToggle />
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 680px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25em 1em;
	}
	.site-title {
		font-weight: 600;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	.internal-links a {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.internal-links a.active {
		color: var(--fg);
	}
	.lang-theme {
		display: flex;
		align-items: center;
		margin-left: 0.75em;
	}
	.lang-switch {
		display: flex;
		gap: 0.35em;
	}
	.flag {
		font-size: 1.1em;
		line-height: 1;
		text-decoration: none;
		filter: none;
		opacity: 1;
		transition:
			filter 0.15s,
			opacity 0.15s;
	}
	.flag.inactive {
		filter: grayscale(1);
		opacity: 0.4;
	}
	.flag.inactive:hover {
		opacity: 0.7;
	}
</style>
