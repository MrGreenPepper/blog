---
import { SITE_TITLE } from '../consts';
import { currentLangFromPath, LANGUAGES, type LangCode } from '../utils/i18n';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
import LangPicker from './LangPicker.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	// Where each language's flag should point on *this* page — e.g. the
	// translated version of the post/page being viewed. Falls back to that
	// language's blog listing for any language not included here, so the
	// switcher always has somewhere sensible to go.
	translationHrefs?: Partial<Record<LangCode | 'de', string>>;
}

const { translationHrefs = {} } = Astro.props;

const basePrefix = withBase('blog');
const current = currentLangFromPath(Astro.url.pathname, basePrefix);
const hrefs = {
	de: withBase('blog'),
	...Object.fromEntries(LANGUAGES.map((l) => [l.code, withBase(`blog/${l.code}`)])),
	...translationHrefs,
};
---

<header>
	<nav>
		<a class="site-title" href={withBase('')}>{SITE_TITLE}</a>
		<button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
			☰
		</button>
		<div class="internal-links" id="nav-links">
			<HeaderLink href={withBase('blog')}>Blog</HeaderLink>
			<HeaderLink href={withBase('about')}>About</HeaderLink>
			<LangPicker current={current} hrefs={hrefs} />
			<ThemeToggle />
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		const toggle = document.getElementById('nav-toggle');
		const links = document.getElementById('nav-links');
		toggle.addEventListener('click', () => {
			const open = links.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(open));
		});
	})();
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		position: relative;
		width: 680px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75em;
		padding: 1.25em 1em;
	}
	.site-title {
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.nav-toggle {
		display: none;
		font: inherit;
		font-size: 1.1em;
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.2em 0.5em;
		color: var(--fg);
		cursor: pointer;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 1.25em;
		flex: 1;
	}
	.internal-links a {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.internal-links a.active {
		color: var(--fg);
	}

	@media (max-width: 720px) {
		.site-title {
			display: none;
		}
		nav {
			justify-content: flex-end;
		}
		.nav-toggle {
			display: inline-flex;
		}
		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			inset-inline-end: 0;
			margin-top: 0.5em;
			flex-direction: column;
			align-items: flex-start;
			gap: 1em;
			background: var(--bg);
			border: 1px solid var(--border);
			border-radius: 6px;
			padding: 1em;
			z-index: 10;
		}
		.internal-links.open {
			display: flex;
		}
	}
</style>
