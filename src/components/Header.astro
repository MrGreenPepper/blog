---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="site-title" href={withBase('')}>{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href={withBase('blog')}>Blog</HeaderLink>
			<HeaderLink href={withBase('about')}>About</HeaderLink>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 680px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25em 1em;
	}
	.site-title {
		font-weight: 600;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	.internal-links a {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.internal-links a.active {
		color: var(--fg);
	}
</style>
