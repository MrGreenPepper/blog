---
import { getEntry, render } from 'astro:content';
import LangSwitch from '../components/LangSwitch.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LANGUAGES } from '../utils/i18n';
import { withBase } from '../utils/url';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const { title, description } = entry.data;
const { Content } = await render(entry);

const hrefs: Record<string, string> = { de: withBase('about') };
for (const language of LANGUAGES) {
	const translated = await getEntry(language.pages, 'about');
	if (translated) hrefs[language.code] = withBase(`blog/${language.code}/about`);
}
const hasTranslations = Object.keys(hrefs).length > 1;
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			{hasTranslations && <LangSwitch current="de" hrefs={hrefs} />}
			<Content />
		</main>
		<Footer />
	</body>
</html>
